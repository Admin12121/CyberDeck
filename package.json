{
  "name": "cyberdeck",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "CyberDeck — integrated cybersecurity workbench (Tauri 2 + Next.js + Rust)",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --filter '@cyberdeck/desktop' dev",
    "build": "bun run --filter '@cyberdeck/desktop' build",
    "typecheck": "bun run --filter '@cyberdeck/desktop' typecheck",
    "tauri": "bun run --filter '@cyberdeck/desktop' tauri",
    "rust:check": "cargo check --workspace",
    "rust:fmt": "cargo fmt --all",
    "icons": "node scripts/gen-icons.mjs",
    "test:core": "cargo test -p cyberdeck-core",
    "test:crypto": "cargo test -p cyberdeck-crypto",
    "test:storage": "cargo test -p cyberdeck-storage",
    "test:packet": "cargo test -p cyberdeck-packet",
    "test:app": "cargo test -p cyberdeck-desktop",
    "test:rust": "cargo test --workspace"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
